# Application
APP_NAME=Production RAG Service
APP_ENV=development
APP_DEBUG=false

# Neon PostgreSQL
NEON_DATABASE_URL=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=production-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# RAG configuration
MAX_UPLOAD_SIZE_MB=20
TOP_K=5
MIN_SIMILARITY_SCORE=0.58
DOCUMENT_STORAGE_DIR=data/uploads

# Direct Neon PostgreSQL connection for database migrations.
NEON_MIGRATION_DATABASE_URL=
